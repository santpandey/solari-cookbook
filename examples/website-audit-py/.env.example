# Get a Solari API key at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Optional: TypeSafe AI Jev (probabilistic impact/confidence scoring of
# findings). Without it, a deterministic impact table is used instead.
# TYPESAFE_API_KEY=...

# --- Deployment / access control -------------------------------------
# Set to require a password before anyone can view or run audits.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
ACCESS_PASSWORD=

# Signs the login session cookie. Required when ACCESS_PASSWORD is set.
# Must be >=32 chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Refuse to start unless ACCESS_PASSWORD + SESSION_SECRET are set
# (always on Railway — RAILWAY_ENVIRONMENT_NAME counts too).
# REQUIRE_ACCESS_PASSWORD=1

# Directory for reports, job journal and history DB — point at a mounted
# volume on Railway (e.g. /data/audits). Default: ./audits
# AUDITS_DIR=/data/audits

# Trusted header carrying the real client IP. Never use x-forwarded-for
# here — clients can spoof it. On Railway: x-real-ip.
# CLIENT_IP_HEADER=x-real-ip
